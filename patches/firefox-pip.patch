+void BraveVideoOverlayWindowViews::LayoutBottomControls() {
+  if (!playback_controls_container_view_->GetVisible()) {
+    return;
+  }
+  const auto size = GetBounds().size();
+  constexpr int kMargin = 12;
+  constexpr int kButtonSize = 32;
+  const int row_y = std::max(0, size.height() - kMargin - kButtonSize);
+  const int progress_y = std::max(0, row_y - 28);
+  progress_view_->SetBounds(kMargin, progress_y,
+                            std::max(0, size.width() - 2 * kMargin), 26);
+  progress_view_->SetEnabled(CanSeek());
+  replay_10_seconds_button_->SetEnabled(CanSeek());
+  forward_10_seconds_button_->SetEnabled(CanSeek());
+
+  if (toggle_mute_button_) {
+    toggle_mute_button_->SetBounds(kMargin, row_y, kButtonSize, kButtonSize);
+  }
+  const int expand_x = size.width() - kMargin - kButtonSize;
+  if (expand_button_) {
+    expand_button_->SetBounds(expand_x, row_y, kButtonSize, kButtonSize);
+  }
+  const int caption_x = expand_x - kButtonSize - 8;
+  live_caption_button_->SetBounds(caption_x, row_y, kButtonSize, kButtonSize);
+  live_caption_dialog_->SetPosition(
+      {std::max(0, caption_x + kButtonSize - live_caption_dialog_->width()),
+       row_y - live_caption_dialog_->height()});
+
+  const int timestamp_x = kMargin + (toggle_mute_button_ ? kButtonSize + 8 : 0);
+  const int timestamp_width = std::max(0, caption_x - 8 - timestamp_x);
+  timestamp_->SetBounds(timestamp_x, row_y + 8, timestamp_width, 16);
+  live_status_->SetBounds(
+      timestamp_x, row_y + 8,
+      std::min(timestamp_width, live_status_->GetPreferredSize({}).width()),
+      16);
+}
+
+bool BraveVideoOverlayWindowViews::CanSeek() const {
+  return position_.duration() > base::TimeDelta() &&
+         !position_.duration().is_max();
+}
+
+void BraveVideoOverlayWindowViews::ToggleExpanded() {
+  const gfx::Rect work_area = GetWorkAreaForWindow();
+  if (bounds_before_expanding_) {
+    gfx::Rect restored = *bounds_before_expanding_;
+    bounds_before_expanding_.reset();
+    restored.AdjustToFit(work_area);
+    SetAspectRatio(gfx::SizeF(natural_size_));
+    SetBounds(restored);
+  } else {
+    bounds_before_expanding_ = GetWindowBoundsInScreen();
+    SetAspectRatio(gfx::SizeF(work_area.size()));
+    SetBounds(work_area);
+  }
+  const auto label = l10n_util::GetStringUTF16(
+      bounds_before_expanding_ ? IDS_ACCNAME_RESTORE : IDS_ACCNAME_MAXIMIZE);
+  expand_button_->SetTooltipText(label);
+  expand_button_->GetViewAccessibility().SetName(label);
+}
+
+bool BraveVideoOverlayWindowViews::ControlsHitTestContainsPoint(
+    const gfx::Point& point) {
+  if (!overlay_view_ && AreControlsVisible() && expand_button_ &&
+      expand_button_->IsDrawn() &&
+      expand_button_->GetMirroredBounds().Contains(point)) {
+    return true;
+  }
+  return VideoOverlayWindowViews::ControlsHitTestContainsPoint(point);
 }
 
 void BraveVideoOverlayWindowViews::OnKeyEvent(ui::KeyEvent* event) {
-  if (event->type() == ui::EventType::kKeyPressed) {
-    if (event->key_code() == ui::VKEY_LEFT) {
-      Replay10Seconds();
+  const bool plain_key = !event->IsAltDown() && !event->IsControlDown() &&
+                         !event->IsCommandDown() && !event->IsShiftDown();
+  if (!plain_key && (event->key_code() == ui::VKEY_LEFT ||
+                     event->key_code() == ui::VKEY_RIGHT ||
+                     event->key_code() == ui::VKEY_SPACE)) {
+    views::Widget::OnKeyEvent(event);
+    return;
+  }
+  if (event->type() == ui::EventType::kKeyPressed && plain_key &&
+      !IsOverlayViewShown() && !live_caption_dialog_->GetVisible() &&
+      playback_controls_container_view_->GetVisible()) {
+    bool handled = true;
+    const bool has_focus = GetFocusManager()->GetFocusedView() != nullptr;
+    switch (event->key_code()) {
+      case ui::VKEY_SPACE:
+        handled = !has_focus && show_play_pause_button_;
+        if (handled && !event->is_repeat()) {
+          TogglePlayPause();
+        }
+        break;
+      case ui::VKEY_K:
+        if (show_play_pause_button_ && !event->is_repeat()) {
+          TogglePlayPause();
+        }
+        break;
+      case ui::VKEY_M:
+        handled = toggle_mute_button_ != nullptr;
+        if (handled && !event->is_repeat()) {
+          controller_->RequestMute(!controller_->GetMuteStatus());
+        }
+        break;
+      case ui::VKEY_F:
+        if (!event->is_repeat()) {
+          ToggleExpanded();
+        }
+        break;
+      case ui::VKEY_ESCAPE:
+        handled = bounds_before_expanding_.has_value();
+        if (handled) {
+          ToggleExpanded();
+        }
+        break;
+      case ui::VKEY_HOME:
+      case ui::VKEY_END:
+        handled = !has_focus && CanSeek();
+        if (handled) {
+          controller_->SeekTo(event->key_code() == ui::VKEY_HOME
+                                  ? base::TimeDelta()
+                                  : position_.duration());
+        }
+        break;
+      case ui::VKEY_LEFT:
+      case ui::VKEY_RIGHT:
+        // Focused controls keep their native arrow-key behavior. For unknown
+        // durations, consume unfocused arrows without sending invalid seeks.
+        handled = !has_focus;
+        if (handled && CanSeek()) {
+          if (event->key_code() == ui::VKEY_LEFT) {
+            Replay10Seconds();
+          } else {
+            Forward10Seconds();
+          }
+        }
+        break;
+      default:
+        handled = false;
+    }
+    if (handled) {
+      hide_controls_timer_.Reset();
+      UpdateControlsVisibility(true);
+      MaybeUpdateMeetsUserInteraction(*event);
       event->SetHandled();
       return;
     }
-    if (event->key_code() == ui::VKEY_RIGHT) {
-      Forward10Seconds();
-      event->SetHandled();
-      return;
-    }
   }
 
   VideoOverlayWindowViews::OnKeyEvent(event);
 }
