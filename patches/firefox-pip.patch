+ protected:
+  void Key(ui::KeyboardCode key, int flags = ui::EF_NONE) {
+    ui::KeyEvent event(ui::EventType::kKeyPressed, key, flags);
+    window_->OnKeyEvent(&event);
+  }
+  void Position(int position, int duration) {
+    window_->SetMediaPosition(media_session::MediaPosition(
+        0, base::Seconds(duration), base::Seconds(position), false));
+  }
+  SimpleOverlayWindowImageButton* expand_button() {
+    return static_cast<BraveVideoOverlayWindowViews*>(window_.get())
+        ->expand_button_for_testing();
+  }
+
+  std::unique_ptr<PipTestController> controller_;
+  std::unique_ptr<VideoOverlayWindowViews> window_;
+
+ private:
+  base::test::ScopedFeatureList features_;
+  display::test::TestScreen screen_;
+  TestingProfile profile_;
+  content::TestWebContentsFactory contents_factory_;
+  std::unique_ptr<speech::MockSodaInstaller> soda_;
+};
+
+TEST_F(FirefoxPipTest, SeeksClampAtBothEnds) {
+  Position(3, 120);
+  Key(ui::VKEY_LEFT);
+  Position(118, 120);
+  Key(ui::VKEY_RIGHT);
+  Key(ui::VKEY_HOME);
+  Key(ui::VKEY_END);
+  EXPECT_EQ(controller_->seeks, (std::vector<base::TimeDelta>{
+                                    base::Seconds(0), base::Seconds(120),
+                                    base::Seconds(0), base::Seconds(120)}));
+}
+
+TEST_F(FirefoxPipTest, UnknownAndLiveDurationsDoNotSeek) {
+  Position(0, 0);
+  Key(ui::VKEY_LEFT);
+  Key(ui::VKEY_RIGHT);
+  EXPECT_FALSE(window_->progress_view_for_testing()->GetEnabled());
+  window_->SetMediaPosition(media_session::MediaPosition(
+      0, base::TimeDelta::Max(), base::Seconds(30), false));
+  Key(ui::VKEY_LEFT);
+  Key(ui::VKEY_RIGHT);
+  Key(ui::VKEY_END);
+  EXPECT_TRUE(controller_->seeks.empty());
+  EXPECT_FALSE(window_->progress_view_for_testing()->GetEnabled());
+  Position(30, 120);
+  EXPECT_TRUE(window_->progress_view_for_testing()->GetEnabled());
+}
+
+TEST_F(FirefoxPipTest, ModifiedKeysDoNotSeekOrTogglePlayback) {
+  Key(ui::VKEY_LEFT, ui::EF_CONTROL_DOWN);
+  Key(ui::VKEY_RIGHT, ui::EF_ALT_DOWN);
+  Key(ui::VKEY_SPACE, ui::EF_CONTROL_DOWN);
+  EXPECT_TRUE(controller_->seeks.empty());
+  EXPECT_EQ(controller_->play_toggles, 0);
+}
+
+TEST_F(FirefoxPipTest, FocusedButtonKeepsArrowKeys) {
+  window_->GetFocusManager()->SetFocusedView(
+      window_->play_pause_controls_view_for_testing());
+  ASSERT_NE(window_->GetFocusManager()->GetFocusedView(), nullptr);
+  Key(ui::VKEY_RIGHT);
+  EXPECT_TRUE(controller_->seeks.empty());
+}
+
+TEST_F(FirefoxPipTest, MuteAndPlaybackIgnoreKeyRepeat) {
+  ASSERT_NE(window_->toggle_mute_button_for_testing(), nullptr);
+  Key(ui::VKEY_M);
+  EXPECT_TRUE(controller_->muted);
+  window_->SetMediaMuted(controller_->muted);
+  EXPECT_TRUE(
+      window_->toggle_mute_button_for_testing()->is_muted_for_testing());
+  Key(ui::VKEY_M, ui::EF_IS_REPEAT);
+  EXPECT_TRUE(controller_->muted);
+  Key(ui::VKEY_M);
+  EXPECT_FALSE(controller_->muted);
+  Key(ui::VKEY_SPACE);
+  Key(ui::VKEY_SPACE, ui::EF_IS_REPEAT);
+  EXPECT_EQ(controller_->play_toggles, 1);
+  Key(ui::VKEY_K);
+  EXPECT_EQ(controller_->play_toggles, 2);
+}
+
+TEST_F(FirefoxPipTest, FooterAndHeaderDoNotOverlapAtSmallSizes) {
+  window_->SetNextTrackButtonVisibility(true);
+  for (const auto& size :
+       {gfx::Size(320, 180), gfx::Size(640, 360), gfx::Size(360, 640)}) {
+    SCOPED_TRACE(size.ToString());
+    window_->SetBounds({{0, 0}, size});
+    window_->OnUpdateControlsBounds();
+    const auto progress = window_->GetProgressViewBounds();
+    EXPECT_EQ(progress.x(), 12);
+    EXPECT_EQ(progress.width(), window_->GetBounds().width() - 24);
+    EXPECT_LE(window_->GetPlayPauseControlsBounds().bottom(), progress.y());
+    EXPECT_LE(progress.bottom(), window_->GetToggleMuteButtonBounds().y());
+    EXPECT_FALSE(window_->GetCloseControlsBounds().Intersects(
+        window_->GetBackToTabControlsBounds()));
+    EXPECT_FALSE(window_->timestamp_for_testing()->bounds().Intersects(
+        window_->GetToggleMuteButtonBounds()));
+    EXPECT_FALSE(window_->timestamp_for_testing()->bounds().Intersects(
+        window_->GetLiveCaptionButtonBounds()));
+    EXPECT_FALSE(expand_button()->bounds().Intersects(
+        window_->GetLiveCaptionButtonBounds()));
+  }
+}
+
+TEST_F(FirefoxPipTest, ExpandAndEscapeRestoreBounds) {
+  const auto original = window_->GetWindowBoundsInScreen();
+  Key(ui::VKEY_F);
+  EXPECT_EQ(window_->GetWindowBoundsInScreen(), gfx::Rect(0, 0, 1280, 800));
+  window_->UpdateNaturalSize({640, 480});
+  EXPECT_EQ(window_->GetWindowBoundsInScreen(), gfx::Rect(0, 0, 1280, 800));
+  Key(ui::VKEY_ESCAPE);
+  EXPECT_EQ(window_->GetWindowBoundsInScreen(), original);
+}
+
+TEST_F(FirefoxPipTest, ExpandButtonAcceptsClicksAndRestoresBounds) {
+  const auto original = window_->GetWindowBoundsInScreen();
+  ASSERT_TRUE(window_->ControlsHitTestContainsPoint(
+      expand_button()->GetMirroredBounds().CenterPoint()));
+  views::test::ButtonTestApi(expand_button()).NotifyDefaultMouseClick();
+  EXPECT_EQ(window_->GetWindowBoundsInScreen(), gfx::Rect(0, 0, 1280, 800));
+  views::test::ButtonTestApi(expand_button()).NotifyDefaultMouseClick();
+  EXPECT_EQ(window_->GetWindowBoundsInScreen(), original);
+}
